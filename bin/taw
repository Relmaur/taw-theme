#!/usr/bin/env php
<?php

/**
 * TAW CLI for this theme. The commands live in taw/core (TAW\CLI\Application)
 * and update with `composer update taw/core`; `vendor/bin/taw` is the same
 * tool. This file stays so `php bin/taw …` keeps working.
 *
 *   php bin/taw list
 *   php bin/taw make:block Hero --type=meta
 *
 * Add a command of your own without editing this file (bin/ is
 * framework-owned and replaced on sync): register it from a file your
 * composer.json autoloads —
 *   TAW\CLI\CommandRegistry::add(fn (string $themeDir) => new MyCommand($themeDir));
 */

declare(strict_types=1);

$themeDir = dirname(__DIR__);
$autoload = $themeDir . '/vendor/autoload.php';
if (!file_exists($autoload)) {
    fwrite(STDERR, "Run 'composer install' first.\n");
    exit(1);
}
require $autoload;

if (class_exists(\TAW\CLI\Application::class)) { // taw/core 1.90+
    exit(\TAW\CLI\Application::main($themeDir));
}

// An older taw/core (this file can arrive by sync before `composer update
// taw/core`): build the command list the way bin/taw did, from what it has.
\TAW\Helpers\Framework::setThemeRoot($themeDir);
$app = new \Symfony\Component\Console\Application('TAW CLI', '1.0.0');
$commands = [
    'MakeBlockCommand' => true, 'ExportBlockCommand' => true, 'ImportBlockCommand' => true,
    'InspectCommand' => true, 'FieldsGetCommand' => true, 'FieldsSetCommand' => true,
    'SyncCommand' => true, 'ExportStaticCommand' => true, 'SeoExtractCommand' => true,
    'SeoInjectCommand' => true, 'WpCliCommand' => true, 'IconsSyncCommand' => false,
    'LogTailCommand' => true, 'ContentExportCommand' => true, 'ContentImportCommand' => true,
    'ContentDiffCommand' => true, 'ContentDefaultsCommand' => true, 'ContentReindexCommand' => true,
    'ContentReindexKbCommand' => true, 'RagUsageCommand' => true, 'CorpusInstallCommand' => true,
    'CorpusExportCommand' => false, 'CatechismInstallCommand' => true, 'CatechismExportCommand' => false,
    'CanonLawInstallCommand' => true, 'CanonLawExportCommand' => false, 'SchemaValidateCommand' => true,
    'SkillsSyncCommand' => true,
];
foreach ($commands as $name => $takesThemeDir) {
    $class = 'TAW\\CLI\\' . $name;
    if (class_exists($class)) {
        $app->add($takesThemeDir ? new $class($themeDir) : new $class());
    }
}
$app->run();
